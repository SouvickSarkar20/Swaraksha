{
    "name": "production-auth-api",
    "version": "1.0.0",
    "description": "Production-grade authentication API in TypeScript",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "vitest",
        "db:generate": "drizzle-kit generate",
        "db:migrate:dev": "tsx src/db/migrate.ts",
        "db:migrate:prod": "node dist/db/migrate.js",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@fastify/swagger": "^9.8.1",
        "@fastify/swagger-ui": "^6.1.0",
        "@neondatabase/serverless": "^0.10.4",
        "@upstash/ratelimit": "^2.0.8",
        "@upstash/redis": "^1.34.4",
        "bcrypt": "^5.1.1",
        "dotenv": "^16.4.7",
        "drizzle-orm": "^0.39.3",
        "fastify": "^5.2.1",
        "fastify-type-provider-zod": "^4.0.2",
        "jsonwebtoken": "^9.0.2",
        "otpauth": "^9.5.1",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.8",
        "@types/node": "^22.13.4",
        "drizzle-kit": "^0.30.4",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "vitest": "^3.0.5"
    }
}
